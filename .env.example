# Frontend — public values only (bundled into the browser)
VITE_API_BASE_URL=http://localhost:3000
VITE_MONAD_EXPLORER_URL=https://testnet.monadexplorer.com

# Backend placeholders — never commit real values
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
TRUSTED_DEMO_TOKEN_ADDRESS=0x21A48A0f107BaF3DC2eDA13e4aB6B7e624397639
DEMO_EVENT_ONLY_ADDRESS=0xa7836d1245593d16929a3Eea3Aa34461EF08F474
HOST=0.0.0.0
PORT=3000
RPC_TIMEOUT_MS=10000
CORS_ORIGINS=http://localhost:5173

# P1 persistence/watcher placeholders
DATABASE_URL=./data/ghostguard.db
WATCH_ENABLED=false
MONITORED_WALLET_ADDRESSES=0x72a319E6ff8A30A8a524C8559DF185164409b9BD,0x07eeAf6BB355fa538eb69Df7A3Fdd6C81E3807fB
WATCH_START_BLOCK=73787270
WATCH_CONFIRMATIONS=5
WATCH_BLOCK_RANGE=100
WATCH_POLL_INTERVAL_MS=3000

# Email alerts — keep credentials in local/host secrets, never commit them
EMAIL_ENABLED=false
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
MONAD_EXPLORER_URL=https://testnet.monadscan.com

# Real transaction producer — disabled until an explicitly funded owner key and budget are configured.
# The key must own DemoEventOnly and hold enough DemoToken + MON for gas.
PRODUCER_ENABLED=false
PRODUCER_PRIVATE_KEY=
PRODUCER_RECIPIENT_ADDRESS=0x07eeAf6BB355fa538eb69Df7A3Fdd6C81E3807fB
PRODUCER_TPS=1
PRODUCER_MAX_TRANSACTIONS=100
PRODUCER_SUSPICIOUS_EVERY=10
PRODUCER_AMOUNT_BASE_UNITS=1
