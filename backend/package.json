{
  "name": "@ghostguard/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "GhostGuard deterministic receipt and log analysis API",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/server.ts",
    "start": "node --env-file-if-exists=.env.local dist/server.js",
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint src",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.4",
    "@ghostguard/shared": "*",
    "fastify": "^5.12.7",
    "viem": "^2.57.11"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  }
}
